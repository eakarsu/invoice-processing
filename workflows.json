      "states":["draft","validating","needs-information","accepted","rejected"],"transitions":[{"id":"validate","label":"Validate Invoice","from":["draft","needs-information"],"to":"validating"},{"id":"request-info","label":"Request Information","from":["validating"],"to":"needs-information"},{"id":"accept","label":"Accept Invoice","from":["validating"],"to":"accepted"},{"id":"reject","label":"Reject Invoice","from":["validating"],"to":"rejected"}],
      "seeds":[{"id":"invoice-1001","state":"draft","invoiceRef":"INV-NS-1048","vendor":"Northstar Office Supply","invoiceDate":"2026-07-10","amount":2840.75,"source":"Local upload"}]
    },
    {
      "id":"data-extraction","title":"Invoice Data Extraction","description":"Extract header, tax, currency, line-item, and payment terms and route uncertain fields for operator validation.",
      "fields":[{"key":"invoiceRef","label":"Invoice Reference","type":"text","required":true},{"key":"documentType","label":"Document Type","type":"select","required":true,"options":["Invoice","Credit memo","Debit memo","Receipt"]},{"key":"extractionMode","label":"Extraction Mode","type":"select","required":true,"options":["Local template","Manual keying","Configured AI provider"]},{"key":"confidenceThreshold","label":"Confidence Threshold","type":"number","required":true},{"key":"reviewer","label":"Validation Reviewer","type":"text","required":true}],
      "states":["queued","extracting","validation","accepted","correction-needed","failed"],"transitions":[{"id":"extract","label":"Extract Fields","from":["queued","failed","correction-needed"],"to":"extracting"},{"id":"validate","label":"Validate Fields","from":["extracting"],"to":"validation"},{"id":"accept","label":"Accept Extraction","from":["validation"],"to":"accepted"},{"id":"correct","label":"Request Correction","from":["validation"],"to":"correction-needed"},{"id":"fail","label":"Record Failure","from":["extracting"],"to":"failed"}],
      "seeds":[{"id":"extraction-1001","state":"queued","invoiceRef":"INV-NS-1048","documentType":"Invoice","extractionMode":"Local template","confidenceThreshold":85,"reviewer":"Jamie Soto"}]
    },
    {
      "id":"duplicate-fraud-review","title":"Duplicate and Fraud Review","description":"Check duplicate numbers, amounts, bank changes, unusual timing, and vendor risk before human disposition.",
      "fields":[{"key":"invoiceRef","label":"Invoice Reference","type":"text","required":true},{"key":"vendorRef","label":"Vendor Reference","type":"text","required":true},{"key":"analysisMode","label":"Analysis Mode","type":"select","required":true,"options":["Local rules","Manual review","Configured AI provider"]},{"key":"riskThreshold","label":"Review Threshold","type":"number","required":true},{"key":"analyst","label":"Review Analyst","type":"text","required":true}],
      "states":["queued","analyzing","signal-found","review","cleared","blocked"],"transitions":[{"id":"analyze","label":"Run Analysis","from":["queued"],"to":"analyzing"},{"id":"signal","label":"Record Signal","from":["analyzing"],"to":"signal-found"},{"id":"review","label":"Start Review","from":["signal-found"],"to":"review"},{"id":"clear","label":"Clear Invoice","from":["analyzing","review"],"to":"cleared"},{"id":"block","label":"Block Invoice","from":["review"],"to":"blocked"}],
      "seeds":[{"id":"fraud-review-1001","state":"queued","invoiceRef":"INV-NS-1048","vendorRef":"VEND-204","analysisMode":"Local rules","riskThreshold":70,"analyst":"Robin Park"}]
    },
    {
      "id":"three-way-match","title":"Purchase Order Three-Way Match","description":"Compare invoice lines with purchase orders and receipts, quantify variances, and require exception resolution.",
      "fields":[{"key":"invoiceRef","label":"Invoice Reference","type":"text","required":true},{"key":"purchaseOrderRef","label":"Purchase Order","type":"text","required":true},{"key":"receiptRef","label":"Goods Receipt","type":"text","required":true},{"key":"tolerancePct","label":"Variance Tolerance Percent","type":"number","required":true},{"key":"owner","label":"Exception Owner","type":"text","required":true}],
      "states":["ready","matching","matched","exception","resolved","approved"],"transitions":[{"id":"match","label":"Run Match","from":["ready"],"to":"matching"},{"id":"matched","label":"Record Match","from":["matching"],"to":"matched"},{"id":"exception","label":"Open Exception","from":["matching"],"to":"exception"},{"id":"resolve","label":"Resolve Exception","from":["exception"],"to":"resolved"},{"id":"approve","label":"Approve Match","from":["matched","resolved"],"to":"approved"}],
      "seeds":[{"id":"match-1001","state":"ready","invoiceRef":"INV-NS-1048","purchaseOrderRef":"PO-2026-552","receiptRef":"GR-2026-552-2","tolerancePct":2,"owner":"AP Operations"}]
    },
    {
      "id":"policy-tax-validation","title":"Policy and Tax Validation","description":"Check spend policy, tax treatment, currency, department coding, and required supporting evidence.",
      "fields":[{"key":"invoiceRef","label":"Invoice Reference","type":"text","required":true},{"key":"policySet","label":"Policy Set","type":"select","required":true,"options":["Operating expense","Capital expense","Travel","Professional services"]},{"key":"taxJurisdiction","label":"Tax Jurisdiction","type":"text","required":true},{"key":"currency","label":"Currency","type":"select","required":true,"options":["USD","CAD","EUR","GBP"]},{"key":"reviewer","label":"Compliance Reviewer","type":"text","required":true}],
      "states":["queued","checking","findings-ready","remediation","compliant","exception-approved"],"transitions":[{"id":"check","label":"Run Checks","from":["queued"],"to":"checking"},{"id":"findings","label":"Save Findings","from":["checking"],"to":"findings-ready"},{"id":"remediate","label":"Request Remediation","from":["findings-ready"],"to":"remediation"},{"id":"comply","label":"Mark Compliant","from":["findings-ready","remediation"],"to":"compliant"},{"id":"exception","label":"Approve Exception","from":["findings-ready"],"to":"exception-approved"}],
      "seeds":[{"id":"policy-check-1001","state":"queued","invoiceRef":"INV-NS-1048","policySet":"Operating expense","taxJurisdiction":"US-NY","currency":"USD","reviewer":"Finance Compliance"}]
    },
    {
      "id":"approval-routing","title":"Invoice Approval Routing","description":"Route invoices by amount, department, risk, and exception status with explicit approval or rejection reasons.",
      "fields":[{"key":"invoiceRef","label":"Invoice Reference","type":"text","required":true},{"key":"department","label":"Department","type":"text","required":true},{"key":"amount","label":"Approval Amount","type":"number","required":true},{"key":"approver","label":"Current Approver","type":"text","required":true},{"key":"priority","label":"Priority","type":"select","required":true,"options":["Standard","High","Urgent"]}],
      "states":["pending","manager-review","finance-review","approved","rejected","returned"],"transitions":[{"id":"manager","label":"Start Manager Review","from":["pending","returned"],"to":"manager-review"},{"id":"finance","label":"Escalate to Finance","from":["manager-review"],"to":"finance-review"},{"id":"approve","label":"Approve Invoice","from":["manager-review","finance-review"],"to":"approved"},{"id":"reject","label":"Reject Invoice","from":["manager-review","finance-review"],"to":"rejected"},{"id":"return","label":"Return for Correction","from":["manager-review","finance-review"],"to":"returned"}],
      "seeds":[{"id":"approval-1001","state":"pending","invoiceRef":"INV-NS-1048","department":"Operations","amount":2840.75,"approver":"Operations Manager","priority":"Standard"}]
    },
    {
      "id":"payment-delivery","title":"Payment Scheduling and Delivery","description":"Schedule an approved payment and track local export, manual bank entry, or an actually configured payment integration.",
      "fields":[{"key":"invoiceRef","label":"Invoice Reference","type":"text","required":true},{"key":"paymentDate","label":"Payment Date","type":"date","required":true},{"key":"amount","label":"Payment Amount","type":"number","required":true},{"key":"deliveryMethod","label":"Delivery Method","type":"select","required":true,"options":["Local payment file","Manual bank entry","Configured payment provider"]},{"key":"providerStatus","label":"Provider Status","type":"select","required":true,"options":["Not required","Not configured","Configured"]}],
