      "seeds":[{"id":"payment-1001","state":"scheduled","invoiceRef":"INV-NS-1048","paymentDate":"2026-07-24","amount":2840.75,"deliveryMethod":"Local payment file","providerStatus":"Not required"}]
    },
    {
      "id":"reconciliation-reporting","title":"AP Reconciliation and Reporting","description":"Reconcile invoice, approval, payment, and ledger records and produce an auditable local operations report.",
      "fields":[{"key":"period","label":"Reporting Period","type":"text","required":true},{"key":"ledgerSource","label":"Ledger Source","type":"select","required":true,"options":["Local ledger fixture","Manual upload","Configured ERP"]},{"key":"varianceThreshold","label":"Variance Threshold","type":"number","required":true},{"key":"format","label":"Report Format","type":"select","required":true,"options":["PDF","CSV","JSON"]},{"key":"owner","label":"Reconciliation Owner","type":"text","required":true}],
      "states":["configured","reconciling","variance-review","balanced","report-ready","published"],"transitions":[{"id":"reconcile","label":"Run Reconciliation","from":["configured"],"to":"reconciling"},{"id":"variance","label":"Review Variances","from":["reconciling"],"to":"variance-review"},{"id":"balance","label":"Mark Balanced","from":["reconciling","variance-review"],"to":"balanced"},{"id":"report","label":"Generate Report","from":["balanced"],"to":"report-ready"},{"id":"publish","label":"Publish Locally","from":["report-ready"],"to":"published"}],
      "seeds":[{"id":"recon-report-1001","state":"configured","period":"2026-06","ledgerSource":"Local ledger fixture","varianceThreshold":1,"format":"PDF","owner":"AP Controller"}]
    }
  ]
